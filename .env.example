PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creamy_cream
REDIS_URL=redis://127.0.0.1:6379/
ACCESS_JWT_SECRET=replace-with-32-byte-random-secret
REFRESH_JWT_SECRET=replace-with-another-32-byte-secret
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173

# Use a dedicated MinIO instance. Endpoint must be resolvable by the browser
# because signed PUT/GET URLs include this host in their signature.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
MINIO_BUCKET=creamy-cream
MINIO_REGION=us-east-1

# Shipping quote provider used by POST /shipments/cost.
# Keep this key on the backend; do not expose it in the browser.
RAJAONGKIR_BASE_URL=https://your-rajaongkir-base-url
RAJAONGKIR_API_KEY=replace-with-rajaongkir-key
